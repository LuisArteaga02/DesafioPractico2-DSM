<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IniciarSeccionActivity"
    android:background="@color/FourColor"
    >

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="460dp"
        android:orientation="vertical"
        android:padding="100px"
        android:background="@drawable/bg3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30px"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <TextView
                android:id="@+id/textView5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:fontFamily="@font/autour_one"
                android:text="Bienvenido a Viajes Rumble"
                android:textAlignment="center"
                android:textColor="@color/MainColor"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/logoavioneta" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginRight="50px"
            android:layout_marginBottom="25px"
            android:fontFamily="@font/autour_one"
            android:text="Login"
            android:textAlignment="center"
            android:textColor="@color/MainColor"
            android:textSize="50px" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginRight="50px"
            android:layout_marginBottom="25px"
            android:fontFamily="@font/autour_one"
            android:text="Correo"
            android:textColor="@color/MainColor" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="25px"
            android:backgroundTint="@color/logoColor"
            android:fontFamily="@font/autour_one"
            android:textColorHint="@color/MainColor" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginRight="50px"
            android:layout_marginBottom="25px"
            android:fontFamily="@font/autour_one"
            android:text="Contraseña"
            android:textColor="@color/MainColor"
            android:textColorHint="@color/MainColor" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="25px"
            android:backgroundTint="@color/logoColor"
            android:ems="10"
            android:fontFamily="@font/autour_one"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnIniciarSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginRight="50px"
            android:layout_marginBottom="25px"
            android:backgroundTint="@color/MainColor"
            android:fontFamily="@font/autour_one"
            android:text="Login"
            android:textColor="@color/TreeColor" />

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50px"
            android:layout_marginRight="50px"
            android:layout_marginBottom="25px"
            android:backgroundTint="@color/MainColor"
            android:fontFamily="@font/autour_one"
            android:text="Registrarte"
            android:textColor="@color/TreeColor" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>